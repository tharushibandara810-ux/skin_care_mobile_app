<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Rutine"
    android:background="@drawable/input_bg">
    <TextView
        android:id="@+id/routineTrackerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/routine_tracker_title"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/primaryColor"
        android:fontFamily="sans-serif-medium"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp" />

    <ImageView
        android:id="@+id/routineTrackerImage"
        android:layout_width="395dp"
        android:layout_height="136dp"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/routine_image_desc"
        android:src="@drawable/skincare_routine" />
    <ListView
        android:id="@+id/routineListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:dividerHeight="2dp"
        android:padding="10dp" />
    <Button
        android:id="@+id/btnAddRoutine"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/add_routine_button"
        android:backgroundTint="@android:color/holo_blue_light"
        android:fontFamily="sans-serif-medium"
        android:padding="12dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp" />
</LinearLayout>
